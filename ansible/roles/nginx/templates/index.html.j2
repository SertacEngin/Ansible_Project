<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduTrack Pro - Campus Management Portal</title>
    <!-- Modernes Tailwind CSS v4 via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Lucide Icons für professionelle Optik -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased flex flex-col min-h-screen">

    <div class="flex-1 flex flex-col md:flex-row">
        
        <!-- SIDEBAR NAVIGATION -->
        <aside class="w-full md:w-64 bg-slate-950 border-r border-slate-800 p-6 flex flex-col justify-between">
            <div>
                <!-- Logo -->
                <div class="flex items-center space-x-3 mb-8">
                    <div class="bg-blue-600 p-2 rounded-xl text-white shadow-lg shadow-blue-500/20">
                        <i data-lucide="graduation-cap" class="w-6 h-6"></i>
                    </div>
                    <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">EduTrack Pro</span>
                </div>

                <!-- Nav Items -->
                <nav class="space-y-1">
                    <a href="#" class="flex items-center space-x-3 bg-slate-900 text-blue-400 px-4 py-3 rounded-xl font-medium transition">
                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 text-slate-400 hover:bg-slate-900 hover:text-white px-4 py-3 rounded-xl font-medium transition">
                        <i data-lucide="book-open" class="w-5 h-5"></i>
                        <span>Meine Kurse</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 text-slate-400 hover:bg-slate-900 hover:text-white px-4 py-3 rounded-xl font-medium transition">
                        <i data-lucide="award" class="w-5 h-5"></i>
                        <span>Prüfungen</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 text-slate-400 hover:bg-slate-900 hover:text-white px-4 py-3 rounded-xl font-medium transition">
                        <i data-lucide="calendar" class="w-5 h-5"></i>
                        <span>Stundenplan</span>
                    </a>
                </nav>
            </div>

            <!-- User Profile Quick View -->
            <div class="pt-6 border-t border-slate-800 mt-6 md:mt-0">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold shadow-md shadow-blue-500/10">
                        MM
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-200">Max Mustermann</p>
                        <p class="text-xs text-slate-500">ID: 948201 (Student)</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 p-6 md:p-10 space-y-8 overflow-y-auto">
            
            <!-- HEADER -->
            <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-800 pb-6">
                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-white">Campus Zentrale</h1>
                    <p class="text-slate-400 text-sm mt-1">Herzlich willkommen zurück im digitalen Universitäts-Portal.</p>
                </div>
            </header>

            <!-- STATS / METRICS OVERVIEW -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Notendurchschnitt</p>
                        <h3 class="text-2xl font-bold text-white mt-1">1,5</h3>
                    </div>
                    <div class="bg-emerald-500/10 p-3 rounded-xl text-emerald-400"><i data-lucide="trending-up" class="w-6 h-6"></i></div>
                </div>
                <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Credits (ECTS)</p>
                        <h3 class="text-2xl font-bold text-white mt-1">75 / 180</h3>
                    </div>
                    <div class="bg-blue-500/10 p-3 rounded-xl text-blue-400"><i data-lucide="bar-chart" class="w-6 h-6"></i></div>
                </div>
                <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Aktive Kurse</p>
                        <h3 class="text-2xl font-bold text-white mt-1">4</h3>
                    </div>
                    <div class="bg-indigo-500/10 p-3 rounded-xl text-indigo-400"><i data-lucide="book-open" class="w-6 h-6"></i></div>
                </div>
                <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Anstehende Prüfungen</p>
                        <h3 class="text-2xl font-bold text-white mt-1">2</h3>
                    </div>
                    <div class="bg-amber-500/10 p-3 rounded-xl text-amber-400"><i data-lucide="alert-circle" class="w-6 h-6"></i></div>
                </div>
            </section>

            <!-- MAIN GRID -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- LEFT: COURSE TABLE & CONTENT -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
                        <div class="p-6 border-b border-slate-800 flex justify-between items-center">
                            <h3 class="text-lg font-bold text-white">Aktuelle Leistungsübersicht</h3>
                            <span class="text-xs bg-slate-900 border border-slate-800 px-3 py-1 rounded-full text-slate-400 font-medium">Sommersemester 2026</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-900/50 border-b border-slate-800 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                                        <th class="p-4 pl-6">Modul / Kurs</th>
                                        <th class="p-4">Typ</th>
                                        <th class="p-4 text-center">Status</th>
                                        <th class="p-4 text-right pr-6">Note</th>
                                    </tr>
                                </thead>
                                <tbody class="text-sm text-slate-300 divide-y divide-slate-900">
                                    <tr class="hover:bg-slate-900/30 transition">
                                        <td class="p-4 pl-6 font-semibold text-white">Software Engineering für verteilte Systeme</td>
                                        <td class="p-4 text-slate-400 text-xs font-mono">Vorlesung</td>
                                        <td class="p-4 text-center"><span class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs px-2.5 py-0.5 rounded-full font-medium">Bestanden</span></td>
                                        <td class="p-4 text-right pr-6 font-bold text-emerald-400">1,3</td>
                                    </tr>
                                    <tr class="hover:bg-slate-900/30 transition">
                                        <td class="p-4 pl-6 font-semibold text-white">Datenbankarchitekturen & SQL-Tuning</td>
                                        <td class="p-4 text-slate-400 text-xs font-mono">Labor</td>
                                        <td class="p-4 text-center"><span class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs px-2.5 py-0.5 rounded-full font-medium">Bestanden</span></td>
                                        <td class="p-4 text-right pr-6 font-bold text-emerald-400">1,7</td>
                                    </tr>
                                    <tr class="hover:bg-slate-900/30 transition">
                                        <td class="p-4 pl-6 font-semibold text-white">Projektmanagement in IT-Projekten</td>
                                        <td class="p-4 text-slate-400 text-xs font-mono">Projekt</td>
                                        <td class="p-4 text-center"><span class="bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs px-2.5 py-0.5 rounded-full font-medium">In Bewertung</span></td>
                                        <td class="p-4 text-right pr-6 font-bold text-slate-500">--</td>
                                    </tr>
                                    <tr class="hover:bg-slate-900/30 transition">
                                        <td class="p-4 pl-6 font-semibold text-white">IT-Sicherheit im Bildungswesen</td>
                                        <td class="p-4 text-slate-400 text-xs font-mono">Seminar</td>
                                        <td class="p-4 text-center"><span class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs px-2.5 py-0.5 rounded-full font-medium">Bestanden</span></td>
                                        <td class="p-4 text-right pr-6 font-bold text-emerald-400">2,0</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: ANNOUNCEMENTS & NEWS -->
                <div class="space-y-6">
                    <div class="bg-slate-950 border border-slate-800 p-6 rounded-2xl shadow-xl space-y-4">
                        <h4 class="text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center space-x-2 border-b border-slate-900 pb-3">
                            <i data-lucide="bell" class="w-4 h-4 text-blue-500"></i>
                            <span>Wichtigste Mitteilungen</span>
                        </h4>
                        
                        <div class="space-y-4">
                            <div class="border-l-2 border-blue-500 pl-3 py-1">
                                <p class="text-xs text-slate-500 font-mono">Heute, 14:20</p>
                                <h5 class="text-sm font-semibold text-white mt-0.5">Wartungsfenster abgeschlossen</h5>
                                <p class="text-xs text-slate-400 mt-1">Das Campus-Portal wurde erfolgreich auf Version 2.4 aktualisiert. Alle Systeme laufen stabil.</p>
                            </div>
                            <div class="border-l-2 border-amber-500 pl-3 py-1">
                                <p class="text-xs text-slate-500 font-mono">Gestern, 09:15</p>
                                <h5 class="text-sm font-semibold text-white mt-0.5">Rückmeldefrist Wintersemester</h5>
                                <p class="text-xs text-slate-400 mt-1">Bitte denken Sie daran, den Semesterbeitrag bis zum 15.08.2026 zu überweisen.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Script für Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
